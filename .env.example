# Copy this file to .env and fill in what you need. Every variable here is
# optional - the app falls back to mocks (or, for cloud account sign-in,
# stays fully disabled) when a variable is unset. See README.md for details
# on each feature.

# --- AI story generation (uses mocks if not provided) ---
XAI_API_KEY=your_grok_api_key_here

# --- Audio narration (uses deterministic silent narration if not provided) ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional per-character voice overrides, and the narrator/default fallback.
# See README.md "Custom Voices" for the resolution order.
ELEVENLABS_VOICE_NARRATOR=your_voice_id
ELEVENLABS_VOICE_DEFAULT=your_voice_id

# --- Story Lab cloud account sign-in (off by default) ---
# Setting STORY_LAB_AUTH_PROVIDER=clerk without CLERK_SECRET_KEY fails fast
# at startup rather than shipping a route that silently 401s. See README.md
# "Cloud Account Sign-In" for what each variable does.
# STORY_LAB_AUTH_PROVIDER=clerk
# CLERK_SECRET_KEY=your_clerk_secret_key_here
# CLERK_ACCOUNT_PORTAL_URL=https://accounts.your-clerk-app.example.com

# --- Development settings ---
NODE_ENV=development
