{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "story-generator/dist/story-generator/browser",
  "framework": null,
  "installCommand": "npm run install:all",
  "rewrites": [
    {
      "source": "/api/story-lab/jobs/:jobId/events",
      "destination": "/api/story-lab/jobs?jobId=:jobId&events=1"
    },
    {
      "source": "/api/story-lab/jobs/:jobId",
      "destination": "/api/story-lab/jobs?jobId=:jobId"
    },
    {
      "source": "/api/story-lab/account/profile",
      "destination": "/api/story-lab/account?resource=profile"
    },
    {
      "source": "/api/story-lab/account/projects/:projectId",
      "destination": "/api/story-lab/account?resource=project&projectId=:projectId"
    },
    {
      "source": "/api/story-lab/account/projects",
      "destination": "/api/story-lab/account?resource=projects"
    },
    {
      "source": "/api/story-lab/account/auth-config",
      "destination": "/api/story-lab/account?resource=auth-config"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; font-src 'self'; media-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ]
}
